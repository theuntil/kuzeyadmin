# ---- Supabase (site ile AYNI proje) ----
# NEXT_PUBLIC_ öneki YOK: bu değerler çalışma anında okunur,
# derleme anında gömülmez. Aynı imaj her ortamda kullanılabilir.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Sitenin adresi — panelden habere/hesaba bağlantı için
SITE_URL=https://kuzeybatihaber.com.tr

# Medya CDN'i
CDN_BASE=https://medya.kuzeybatihaber.com.tr

# ---- Cloudflare R2 -------------------------------------------
# ⚠ SUNUCUDA KALIR. NEXT_PUBLIC_ öneki ASLA verme — verirsen
#   imaja gömülür ve herkes bucket'a yazabilir.
#
# Supabase Storage artık KULLANILMIYOR. Avatar, kitaplık, logo,
# yazar görselleri — hepsi bot medyasıyla aynı R2 bucket'ında.
S3_ENDPOINT=https://xxxxx.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=haber-medya
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
